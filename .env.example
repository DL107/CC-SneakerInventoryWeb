# SQLite connection string used for local development.
# For production, point this at a PostgreSQL/Supabase connection string instead, e.g.
# DATABASE_URL="postgresql://user:password@host:5432/sneaker_shelf"
DATABASE_URL="file:./dev.db"

# Random 32+ character secret used to sign session JWTs. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"
